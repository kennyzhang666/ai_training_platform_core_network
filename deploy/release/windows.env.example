# Windows x64 离线发布包。所有相对路径均以发布包根目录为基准。
NODE_ENV=production
PLATFORM_DEPLOYMENT_PROFILE=single-node
PLATFORM_RUNTIME_MODE=bundled
HOST=127.0.0.1
PORT=3000
PROJECT_ROOT=.
NODE_EXE=runtime/node/node.exe
PYTHON=runtime/python/python.exe
LDAP_GATEWAY_PYTHON=runtime/python/python.exe
NGINX_EXE=runtime/nginx/nginx.exe

PLATFORM_REPOSITORY=postgres
# 已验证数据库兼容基线：PostgreSQL 14。
DATABASE_URL=postgresql://ai_training:change-me@127.0.0.1:5432/ai_training?schema=public&connection_limit=10&pool_timeout=30
PERSIST_TRANSACTION_TIMEOUT_MS=120000
OBJECT_STORAGE_MODE=local
ARTIFACT_ROOT=data/artifacts
ARTIFACT_UPLOAD_TMP_ROOT=runtime-state/artifact-uploads
ENGINE_PACKAGE_ROOT=data/engine-packages
SINGLE_NODE_DATA_ROOT=data
SINGLE_NODE_BACKUP_ROOT=backups
SINGLE_NODE_RUNTIME_ROOT=runtime-state

PLATFORM_IDENTITY_MODE=TRUSTED_GATEWAY
TRUSTED_GATEWAY_HMAC_SECRET=<至少32字符的随机密钥>
TRUSTED_GATEWAY_MAX_AGE_SECONDS=90
PLATFORM_BOOTSTRAP_GLOBAL_ADMIN_EMPLOYEE_NO=<首位全局管理员工号>
ALLOW_ANONYMOUS_LOCAL=false
INTRANET_HTTP_ONLY=true
LDAP_GATEWAY_COOKIE_SECURE=false
LDAP_GATEWAY_HOST=127.0.0.1
LDAP_GATEWAY_PORT=8081
LDAP_GATEWAY_SESSION_SECRET=<另一条至少32字符的随机密钥>
LDAP_SERVER=china.huawei.com
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_START_TLS=false
LDAP_BASE_DN=dc=china,dc=huawei,dc=com
LDAP_BIND_PREFIX=China\
LDAP_ACCOUNT_ATTRIBUTE=sAMAccountName
LDAP_TITLE_ATTRIBUTE=title
LDAP_DEPARTMENT_ATTRIBUTE=department
LDAP_NAME_ATTRIBUTE=displayName
LDAP_TIMEOUT_SECONDS=5

EMBEDDED_EVALUATION_WORKER=false
PLATFORM_API=http://127.0.0.1:3000/api/v1
EVALUATION_WORKER_ID=single-node-worker
EVALUATION_WORKER_EMPLOYEE_NO=<已有全局管理员工号>
EVALUATION_WORKER_NAME=<该管理员的SSO姓名>
EVALUATION_WORKER_DEPARTMENT=
EVALUATION_WORKER_TRUSTED_GATEWAY_SECRET=<与TRUSTED_GATEWAY_HMAC_SECRET相同>
EVALUATION_BATCH_ROOT=runtime-state/evaluation-batches
EVALUATION_LOG_ROOT=runtime-state/evaluation-logs
EVALUATION_KEEP_BATCHES=false
ENGINE_CACHE_ROOT=data/worker-engines
ENGINE_PIP_OFFLINE=true
ENGINE_PIP_FIND_LINKS=deploy/single-node/wheelhouse
PIP_CACHE_DIR=data/pip-cache

CODE_AGENT_COMMAND=codeagent
CODE_AGENT_ARGS_JSON=["-p","{{prompt}}"]
CODE_AGENT_ALLOWED_EXECUTABLES=codeagent
EVALUATION_ARCHIVE_MAX_FILES=10000
EVALUATION_ARCHIVE_MAX_UNCOMPRESSED_BYTES=536870912
EVALUATION_ARCHIVE_MAX_FILE_BYTES=134217728
SINGLE_NODE_LISTEN_PORT=8080
SINGLE_NODE_SERVER_NAME=_
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
