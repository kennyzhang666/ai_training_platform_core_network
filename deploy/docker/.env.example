# Docker 单服务器部署。执行 ./manage.sh Prepare 后再编辑生成的 .env。
COMPOSE_PROJECT_NAME=ai-training-platform
AI_TRAINING_IMAGE=ghcr.io/kennyzhang666/ai_training_platform_core_network:0.9.8-docker.1
POSTGRES_IMAGE=postgres:16-bookworm
PLATFORM_BIND_ADDRESS=0.0.0.0
PLATFORM_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

POSTGRES_DB=ai_training
POSTGRES_USER=ai_training
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
POSTGRES_CONNECTION_LIMIT=20
POSTGRES_POOL_TIMEOUT=30

TRUSTED_GATEWAY_HMAC_SECRET=__GENERATE_TRUSTED_SECRET__
LDAP_GATEWAY_SESSION_SECRET=__GENERATE_SESSION_SECRET__
TRUSTED_GATEWAY_MAX_AGE_SECONDS=90
PLATFORM_BOOTSTRAP_GLOBAL_ADMIN_EMPLOYEE_NO=<首位全局管理员工号>

LDAP_SERVER=<企业LDAP地址>
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_START_TLS=true
LDAP_BASE_DN=<企业LDAP根DN>
LDAP_BIND_PREFIX=<域账号前缀>
LDAP_ACCOUNT_ATTRIBUTE=sAMAccountName
LDAP_TITLE_ATTRIBUTE=title
LDAP_DEPARTMENT_ATTRIBUTE=department
LDAP_NAME_ATTRIBUTE=displayName
LDAP_TIMEOUT_SECONDS=5
LDAP_CA_CERT_FILE=
LDAP_GATEWAY_COOKIE_SECURE=false
LDAP_MOCK=false

EVALUATION_WORKER_ID=docker-worker-01
EVALUATION_WORKER_EMPLOYEE_NO=<已有全局管理员工号>
EVALUATION_WORKER_NAME=<该管理员的SSO姓名>
EVALUATION_WORKER_DEPARTMENT=
EVALUATION_KEEP_BATCHES=false
ENGINE_WHEELHOUSE_PATH=./wheelhouse

# 把组织批准的 Code Agent 及其依赖放在 ./code-agent，容器内只读挂载。
CODE_AGENT_BUNDLE_PATH=./code-agent
CODE_AGENT_COMMAND=/opt/code-agent/bin/code-agent
CODE_AGENT_ARGS_JSON=["--prompt","{{prompt}}"]
CODE_AGENT_ALLOWED_EXECUTABLES=/opt/code-agent/bin/code-agent
CODE_AGENT_BATCH_TIMEOUT_SECONDS=3600
