{
  "schemaVersion": "1.1",
  "root": { "mode": "ARCHIVE_ROOT" },
  "required": [
    { "path": "SPEC.md", "type": "markdown", "minSections": 10, "minChars": 3000, "notTemplate": true },
    { "path": "README.md", "type": "markdown", "minSections": 3, "minChars": 500, "notTemplate": true },
    { "path": "AI_WORKLOG.md", "type": "markdown", "minSections": 5, "minChars": 1000, "notTemplate": true },
    { "path": "src/log_redactor.py", "type": "source", "mustExport": "redact_line", "signature": "(line, rules=None)" },
    { "path": "tests/test_log_redactor.py", "type": "source" }
  ],
  "optional": [],
  "forbidden": [
    "**/.env",
    "**/.git/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/*credential*",
    "**/*secret*"
  ],
  "languageEntry": { "python": "src/log_redactor.py" },
  "allowedPaths": [
    "SPEC.md",
    "README.md",
    "AI_WORKLOG.md",
    "src/log_redactor.py",
    "tests/test_log_redactor.py"
  ],
  "allowAdditionalPaths": false,
  "maxDepth": 3,
  "maxFiles": 20
}
