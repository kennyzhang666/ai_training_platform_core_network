{
  "schemaVersion": "1.1",
  "id": "sdd-log-redaction-spec-evaluator",
  "version": "1.0.0",
  "title": "SDD 日志脱敏综合评测引擎",
  "description": "基于冻结交付件，对 SPEC、实现、测试和 AI 协作记录执行 16 个评分点的确定性评测。",
  "runtime": {
    "type": "python",
    "entrypoint": "judge.py",
    "pythonVersion": ">=3.11"
  },
  "agent": {
    "instruction": "instruction.md",
    "skills": ["skills/evaluation"]
  },
  "limits": {
    "wallClockSeconds": 180,
    "memoryMB": 512,
    "outputBytes": 2097152
  },
  "assets": {
    "submissionContract": "assets/submission-contract.json",
    "testsDir": "assets/hidden-tests",
    "referenceDir": "assets/reference"
  },
  "selfCheck": {
    "expectMinTotal": 100,
    "expectStatus": "COMPLETE"
  },
  "metadata": {
    "rubric": "V1-V4/S1-S4/C1-C4/P1-P4",
    "primaryEvidence": "SPEC.md"
  }
}
