generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionSource {
  UPLOAD
  GIT_REF
}

enum TriggerType {
  AUTO
  MANUAL
  IMPORT
}

enum RevealMode {
  IMMEDIATE
  ON_RELEASE
}

enum EventStatus {
  OPEN
  CLOSED
  RELEASED
}

enum SubmissionState {
  RECEIVED
  QUEUED
  WAITING_TRIGGER
  WAITING_IMPORT
  IMPORT_VALIDATING
  FAILED
  GRADED
  SEALED
  REVEALED
}

model OrgUnit {
  id        String    @id @default(cuid())
  parentId  String?
  parent    OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children  OrgUnit[] @relation("OrgTree")
  path      String    @unique
  level     Int
  label     String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     AppUser[]

  @@index([parentId])
  // Sibling-name uniqueness is represented by the partial PostgreSQL indexes
  // in 0011/0012 because Prisma cannot express the separate NULL-parent
  // (root organization) invariant in the model DSL.
  @@index([parentId, name])
}

model AppUser {
  id           String   @id
  employeeNo   String   @unique
  name         String
  nickname     String?
  avatarDataUrl String?
  orgUnitId    String?
  orgPath      String?
  departmentHint   String?
  departmentSource String?
  roles        Json     @default("[]")
  status       String   @default("ACTIVE")
  orgUnit      OrgUnit? @relation(fields: [orgUnitId], references: [id])
  roleBindings  RoleBinding[]
  submissions   Submission[] @relation("SubjectSubmissions")
  participations Participation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgPath])
  @@index([status])
  @@index([name, id])
  @@index([orgPath, id])
  @@index([status, employeeNo, id])
  @@index([status, name, id])
  @@index([status, orgPath, id])
}

model RoleBinding {
  id           String   @id @default(cuid())
  userId       String
  user         AppUser  @relation(fields: [userId], references: [id])
  role         String
  scopeOrgPath String
  createdAt    DateTime @default(now())

  @@unique([userId, role, scopeOrgPath])
  @@index([scopeOrgPath])
}

model Challenge {
  id          String            @id
  ownerOrgPath String
  origin      String
  category    String            @default("TRAINING")
  status      String            @default("DRAFT")
  archivedFrom String?
  board       Json?
  versions    ChallengeVersion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ChallengeVersion {
  id                 String   @id @default(cuid())
  challengeId        String
  challenge          Challenge @relation(fields: [challengeId], references: [id])
  version            Int
  title              String
  summary            String?
  description        String?
  descriptionFormat  String   @default("MARKDOWN")
  objectives         Json?
  requirements       Json?
  constraints        Json?
  deliverables       Json?
  tags               Json?
  estimatedMinutes   Int?
  zone               String
  languagePolicy     Json
  deliveryPolicy     Json
  rubricVersion      String
  submissionContract Json
  submissionContractDefinition Json?
  evaluationEngine   Json?
  tests              Json?
  resources          Json?
  resourceLimits     Json?
  changePackage      Json?
  visibility         String?
  bounty             Decimal? @db.Decimal(8, 2)
  explore            Boolean @default(false)
  status             String  @default("DRAFT")
  createdAt          DateTime @default(now())

  events Event[]
  evaluationBatches EvaluationBatch[]

  @@unique([challengeId, version])
}

model Event {
  id                 String           @id
  challengeVersionId String
  challengeVersion   ChallengeVersion @relation(fields: [challengeVersionId], references: [id])
  mode               String
  submissionSource   SubmissionSource
  deliveryConfig     Json
  trigger            TriggerType
  reveal             RevealMode
  participantMode    String           @default("OPEN")
  purpose            String?
  accessPolicy       Json?
  rubricVersion      String           @default("1.0")
  startsAt           DateTime?
  endsAt             DateTime?
  status             EventStatus      @default(OPEN)
  localGrading       Json?
  submissions        Submission[]
  evaluationBatches  EvaluationBatch[]
  participants       Participation[]
  seasonLinks        SeasonEvent[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Submission {
  id            String           @id @default(cuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id])
  subjectId     String
  subject       AppUser          @relation("SubjectSubmissions", fields: [subjectId], references: [id])
  orgPathSnapshot String?
  sourceType    SubmissionSource
  snapshotHash  String
  artifactUri   String?
  artifactName  String?
  artifactHash  String?
  repository    String?
  branch        String?
  commitSha     String?
  workspacePath String?
  submittedAt   DateTime
  state         SubmissionState  @default(RECEIVED)
  challengeVersionSnapshot String?
  rubricVersionSnapshot    String?
  gradingStatus String?
  gradingAttempt Int?
  previousResultIds Json?
  failureReason String?
  gradingRuns   GradingRun[]
  results       EvaluationResult[]
  // Historical relations contain every attempt; these fields identify the
  // current pointers after a regrade and therefore survive process restart.
  currentGradingRunId String?
  currentResultId    String?
  createdAt     DateTime         @default(now())

  @@unique([eventId, subjectId, snapshotHash])
  @@index([eventId, state])
  @@index([eventId, state, createdAt, id])
  @@index([subjectId, createdAt, id])
}

model GradingRun {
  id              String           @id
  submissionId    String
  submission      Submission       @relation(fields: [submissionId], references: [id])
  triggerType     TriggerType
  triggeredBy     String?
  status          String
  idempotencyKey  String
  graderVersion   String?
  attempt         Int?
  failureReason   String?
  leaseId         String?
  leasedBy        String?
  leaseExpiresAt  DateTime?
  evaluationBatchId String?
  evaluationBatch EvaluationBatch? @relation(fields: [evaluationBatchId], references: [id])
  createdAt       DateTime         @default(now())
  result          EvaluationResult?

  @@unique([submissionId, idempotencyKey])
  @@index([evaluationBatchId])
}

model EvaluationBatch {
  id                 String           @id
  eventId            String
  event              Event            @relation(fields: [eventId], references: [id])
  challengeVersionId String
  challengeVersion   ChallengeVersion @relation(fields: [challengeVersionId], references: [id])
  runIds             Json
  submissionIds      Json
  engineIdentity     String
  codeAgentRuntime   Json?
  createdBy          String
  status             String
  leaseId            String?
  completionLeaseId  String?
  leasedBy           String?
  leaseExpiresAt     DateTime?
  completedRunIds    Json?
  failedRunIds       Json?
  failureReason      String?
  finishedAt         DateTime?
  gradingRuns        GradingRun[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([eventId, status])
  @@index([status, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String
  updatedAt DateTime @updatedAt
}

model Participation {
  eventId         String
  event           Event   @relation(fields: [eventId], references: [id])
  subjectId       String
  subject         AppUser @relation(fields: [subjectId], references: [id])
  orgPathSnapshot String
  importedAt      DateTime @default(now())

  @@id([eventId, subjectId])
  @@index([subjectId])
}

model Season {
  id         String        @id
  name       String
  status     String        @default("DRAFT")
  eventLinks SeasonEvent[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model SeasonEvent {
  seasonId String
  season   Season  @relation(fields: [seasonId], references: [id])
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id])
  weight   Decimal @default(1) @db.Decimal(8, 3)

  @@id([seasonId, eventId])
  @@index([eventId])
}

model EvaluationResult {
  id                 String          @id
  gradingRunId       String          @unique
  gradingRun         GradingRun      @relation(fields: [gradingRunId], references: [id])
  submissionId       String
  submission         Submission      @relation(fields: [submissionId], references: [id])
  schemaVersion      String
  rubricVersion      String
  total              Decimal         @db.Decimal(6, 2)
  status             String
  resultJson         Json
  importedAt         DateTime?
  createdAt          DateTime        @default(now())
  criteria           CriterionResult[]
  findings           Finding[]

  @@index([submissionId, createdAt])
}

model CriterionResult {
  id                 String           @id @default(cuid())
  evaluationResultId String
  evaluationResult   EvaluationResult @relation(fields: [evaluationResultId], references: [id])
  criterionKey       String
  dimension          String
  level              String
  score              Decimal          @db.Decimal(6, 2)
  max                Decimal          @db.Decimal(6, 2)
  source             String
  evidenceJson       Json?

  @@unique([evaluationResultId, criterionKey])
}

model Finding {
  id                 String           @id
  evaluationResultId String
  evaluationResult   EvaluationResult @relation(fields: [evaluationResultId], references: [id])
  criterionKey       String
  severity           String
  title              String
  file               String?
  line               Int?
  detail             String
  fix                String?
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([target, createdAt])
  @@index([createdAt, id])
}

model Announcement {
  id          String   @id
  title       String
  summary     String
  tag         String
  publishedAt DateTime
  pinned      Boolean  @default(false)
  orgPath     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Transitional state envelope used by the PostgreSQL PlatformStore adapter.
/// Domain repositories remain the long-term normalized boundary; the envelope
/// makes the adapter switch atomic while the remaining vertical slices migrate.
model PlatformSnapshot {
  id            String   @id
  schemaVersion Int      @default(1)
  revision      Int      @default(0)
  state         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Short-lived capability state for two-phase object uploads.  The bearer
/// token is never stored; tokenHash and the CAS status survive API restarts.
model UploadSession {
  id              String   @id
  tokenHash       String
  objectKey       String
  actorId         String
  eventId         String
  subjectId       String
  fileName        String
  declaredSize    Int
  status          String   @default("CREATED")
  expiresAt       DateTime
  uploadedSize    Int?
  uploadedSha256  String?
  completedUri    String?
  completedSize   Int?
  completedSha256 String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt, status])
  @@index([actorId, eventId])
  @@index([actorId, eventId, subjectId])
}
