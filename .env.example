# Optional local adapter overrides
PORT=3000
HOST=127.0.0.1
PLATFORM_DATA_FILE=tmp/platform-data.json
# Tests can use an isolated in-memory store: PLATFORM_DATA_FILE=:memory:
ARTIFACT_ROOT=tmp/artifacts
LOCAL_WORKSPACE_ROOT=.
# Optional local Git fixture root. Repositories must be relative paths below it;
# register-git then archives the requested branch tip and computes the server hash.
# LOCAL_GIT_ROOT=tmp/git-repos
# GRADER_TIMEOUT_MS=180000
# EXTRACT_TIMEOUT_MS=30000
# GIT_COMMAND_TIMEOUT_MS=30000
# PYTHON=.venv/Scripts/python.exe
# LOCAL_GRADING_CONCURRENCY=2
# Only enable this explicitly for a single-user local demo. When enabled,
# requests without X-Employee-Id use the seeded local administrator.
ALLOW_ANONYMOUS_LOCAL=false
