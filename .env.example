# Optional local adapter overrides
PORT=3000
HOST=127.0.0.1
PLATFORM_DATA_FILE=tmp/platform-data.json
# Every production profile uses PostgreSQL 14 or newer; PostgreSQL 14 is the
# certified intranet baseline. The single-node profile keeps the
# database on the same server and avoids S3/MinIO, Redis, Kafka and Docker.
# PLATFORM_DEPLOYMENT_PROFILE=single-node
PLATFORM_REPOSITORY=file
# DATABASE_URL=postgresql://platform:change-me@127.0.0.1:5432/ai_training_platform
# Tests can use an isolated in-memory store: PLATFORM_DATA_FILE=:memory:
# File-adapter local startup uses the compact demo fixture by default: one
# published challenge, one training event, one department, one global admin,
# two learners and one mentor. Set FULL only for legacy fixture suites.
# PLATFORM_SEED_PROFILE=MINIMAL
# Transaction guardrails for PostgreSQL domain writes and restore/import jobs.
# PERSIST_TRANSACTION_TIMEOUT_MS=120000
# MIGRATION_TRANSACTION_TIMEOUT_MS=120000
# RESTORE_TRANSACTION_TIMEOUT_MS=120000

# Object storage. Standard production defaults to S3; single-node production
# keeps bytes locally while upload capability state remains in PostgreSQL.
OBJECT_STORAGE_MODE=local
# OBJECT_STORAGE_MODE=s3
# OBJECT_STORAGE_BUCKET=ai-training-platform
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ENDPOINT=https://s3.example.internal
# OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
# OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_PREFIX=platform
ARTIFACT_ROOT=tmp/artifacts
# Expired upload staging cleanup interval; production bucket lifecycle rules
# remain the final backstop for objects left after an API failure.
OBJECT_STORAGE_CLEANUP_INTERVAL_SECONDS=300
LOCAL_WORKSPACE_ROOT=.
# Optional local Git fixture root. Repositories must be relative paths below it;
# register-git then archives the requested branch tip and computes the server hash.
# LOCAL_GIT_ROOT=tmp/git-repos
# GRADER_TIMEOUT_MS=180000
# EXTRACT_TIMEOUT_MS=30000
# GIT_COMMAND_TIMEOUT_MS=30000
# PYTHON=.venv/Scripts/python.exe
# LOCAL_GRADING_CONCURRENCY=2
# Only enable this explicitly for a single-user local demo. When enabled,
# requests without X-Employee-Id use the seeded local administrator.
ALLOW_ANONYMOUS_LOCAL=false
# Production request identity. LOCAL is for development/tests only. Choose
# TRUSTED_GATEWAY for an internal HMAC-signed gateway assertion, or OIDC for a
# Bearer JWT validated against the configured issuer/audience/JWKS endpoint.
# PLATFORM_IDENTITY_MODE=OIDC
# OIDC_ISSUER=https://idp.example.com/
# OIDC_AUDIENCE=ai-training-platform
# OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# OIDC_EMPLOYEE_CLAIM=employeeNo
# OIDC_NAME_CLAIM=name
# OIDC_DEPARTMENT_CLAIM=department
# TRUSTED_GATEWAY_HMAC_SECRET=replace-with-a-secret
# TRUSTED_GATEWAY_MAX_AGE_SECONDS=90
# 全新空库首次启用时，只有该工号且仅在系统尚无全局管理员时会获得全局管理员权限。
# 完成首次登录并确认权限后可删除此项；它不会授予第二位全局管理员。
# PLATFORM_BOOTSTRAP_GLOBAL_ADMIN_EMPLOYEE_NO=w00001
# 打包评测引擎（PACKAGED）
ENGINE_PACKAGE_ROOT=tmp/engine-packages
# ENGINE_PACKAGE_MAX_BYTES=33554432
# ENGINE_MAX_WALL_SECONDS=600
# ENGINE_MAX_MEMORY_MB=2048
# ENGINE_PIP_INDEX_URL=https://internal.mirror/simple
# 离线轮子目录；Windows 下多个目录使用分号分隔，Linux 下使用冒号分隔。
# ENGINE_PIP_FIND_LINKS=D:\ai-training-wheelhouse
# JSON 写法不受系统路径分隔符影响。
# ENGINE_PIP_FIND_LINKS_JSON=["D:/ai-training-wheelhouse"]
# ENGINE_PIP_OFFLINE=false
# ENGINE_DEPENDENCY_TIMEOUT_MS=300000
# 评测环境（拉取式）。默认由 scripts/evaluation-worker.mjs 领取批次并调用 Code Agent。
EMBEDDED_EVALUATION_WORKER=false
# Worker 拉取 API、身份和本地批次目录；也可以用 evaluation-worker.mjs 的命令行参数覆盖。
# PLATFORM_API=http://127.0.0.1:3000/api/v1
# PLATFORM_EMPLOYEE_ID=w00123
# EVALUATION_WORKER_ID=worker-local
# TRUSTED_GATEWAY 部署中，Worker 使用已有管理员账号领取和回传批次。
# 姓名必须与该账号在 SSO 中的姓名一致，避免覆盖人员资料。
# EVALUATION_WORKER_EMPLOYEE_NO=w00001
# EVALUATION_WORKER_NAME=平台管理员
# EVALUATION_WORKER_DEPARTMENT=AI 工程团队
# EVALUATION_WORKER_TRUSTED_GATEWAY_SECRET=replace-with-the-gateway-secret
# EVALUATION_BATCH_ROOT=tmp/evaluation-batches
# EVALUATION_LOG_ROOT=tmp/evaluation-logs
# Agent stdout/stderr 单文件最大 4 MiB，超出部分会截断并记录在 interaction.jsonl。
# EVALUATION_AGENT_OUTPUT_MAX_BYTES=4194304
# Worker 生命周期日志最大 16 MiB，达到上限后从头滚动保留最新记录。
# EVALUATION_WORKER_LOG_MAX_BYTES=16777216
# EVALUATION_HEARTBEAT_SECONDS=60
# EVALUATION_KEEP_BATCHES=false
# EVALUATION_LEASE_SECONDS=900
# EVALUATION_LEASE_MAX_BATCH=20
# EVALUATION_BATCH_LEASE_SECONDS=1800
# EVALUATION_BATCH_LEASE_MAX=5
# Worker 安全解压上限：文件项数、解压后总字节数、单文件字节数。
# EVALUATION_ARCHIVE_MAX_FILES=10000
# EVALUATION_ARCHIVE_MAX_UNCOMPRESSED_BYTES=536870912
# EVALUATION_ARCHIVE_MAX_FILE_BYTES=134217728
# 公司 Code Agent 默认模板为：codeagent -p "{{prompt}}"；-p 使用非交互模式，任务指令由平台按赛题、引擎、Skills 和提交清单自动组合。
# 以下变量仅作为 Worker 主机兜底；兜底 bridge 会收到 --manifest <batch-manifest.json>。
# CODE_AGENT_COMMAND=codeagent
# JSON 数组；{{prompt}} 由 Worker 自动替换，管理员无需填写模型参数。
# CODE_AGENT_ARGS_JSON=["-p","{{prompt}}"]
# 可选的 Worker 主机白名单，限制平台配置能够启动的可执行文件（名称或绝对路径，逗号分隔）。
# CODE_AGENT_ALLOWED_EXECUTABLES=codeagent
# Worker 主机超时覆盖；未设置时使用批次冻结的平台配置，再按引擎时限自动计算，最长 6 小时。
# CODE_AGENT_BATCH_TIMEOUT_SECONDS=3600
# Code Agent 配置测试默认关闭；仅在受控开发环境开启，生产环境即使设置也会被 API 拒绝。
# CODE_AGENT_RUNTIME_TEST_ENABLED=false
# 单次配置测试的最大秒数（10-300，默认 120）；不会改变正式批次超时。
# CODE_AGENT_RUNTIME_TEST_MAX_SECONDS=120
# EXECUTOR_ROOT=executors
